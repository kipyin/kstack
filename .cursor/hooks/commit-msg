#!/usr/bin/env bash
# @kstack-identity
# House git hook dispatcher. Git invokes this as commit-msg / pre-commit / etc.
# Chain Cursor's *.cursor* hooks, then always strip attribution on commit-msg.
set -euo pipefail

HOOK_NAME="$(basename "$0")"
HERE="$(cd "$(dirname "$0")" && pwd)"
HOUSE="${HOME}/.cursor/identity-hooks"
# Inherit from a parent copy of this script. Never reset — that reopens the loop
# when Cursor's agent-hooks dir points .cursor-original-hooks-path at HOUSE.
export SEEN="${SEEN:-}"

is_kstack_dispatcher() {
  local hook="$1"
  [[ -e "$hook" ]] || return 1
  grep -q '@kstack-identity' "$hook" 2>/dev/null
}

should_skip_orig() {
  local orig="$1"
  local orig_hook="$2"
  local orig_norm=""
  if [[ -n "$orig" && -d "$orig" ]]; then
    orig_norm="$(cd "$orig" && pwd)"
  fi

  if [[ -n "$orig_norm" ]]; then
    case " $SEEN " in
      *" $orig_norm "*) return 0 ;;
    esac
    if [[ "$orig_norm" == "$HERE" || "$orig_norm" == "$HOUSE" ]]; then
      return 0
    fi
  fi

  if is_kstack_dispatcher "$orig_hook"; then
    return 0
  fi
  return 1
}

run_cursor_dir() {
  local dir="$1"
  shift
  local orig orig_hook hook
  if [[ -f "$dir/.cursor-original-hooks-path" ]]; then
    orig="$(tr -d '\n' < "$dir/.cursor-original-hooks-path")"
    orig_hook="${orig}/${HOOK_NAME}"
    if [[ -n "$orig" && -x "$orig_hook" ]] && ! should_skip_orig "$orig" "$orig_hook"; then
      "$orig_hook" "$@"
    fi
  fi
  shopt -s nullglob
  for hook in "$dir"/$HOOK_NAME.cursor*; do
    [[ -x "$hook" ]] || continue
    case "$(basename "$hook")" in
      *.cursor.strip-attribution) continue ;;
    esac
    "$hook" "$@"
  done
}

consider() {
  local dest="$1"
  shift
  [[ -d "$dest" ]] || return 0
  local norm
  norm="$(cd "$dest" && pwd)"
  case " $SEEN " in
    *" $norm "*) return 0 ;;
  esac
  SEEN="${SEEN} ${norm}"
  export SEEN
  run_cursor_dir "$norm" "$@"
}

consider "$HERE" "$@"
shopt -s nullglob
for d in "${HOME}/.cursor/agent-hooks/"*/; do
  consider "$d" "$@"
done

if [[ "$HOOK_NAME" != commit-msg ]]; then
  exit 0
fi

MSG_FILE="${1:-}"
STRIP=""
if [[ -x "$HERE/commit-msg.cursor.strip-attribution" ]]; then
  STRIP="$HERE/commit-msg.cursor.strip-attribution"
elif [[ -x "${HOME}/.cursor/identity-hooks/commit-msg.cursor.strip-attribution" ]]; then
  STRIP="${HOME}/.cursor/identity-hooks/commit-msg.cursor.strip-attribution"
fi
if [[ -n "$STRIP" ]]; then
  "$STRIP" "$MSG_FILE"
  exit 0
fi

# Last-resort inline strip if the sibling script is missing.
if [[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]]; then
  exit 0
fi
TMP="$(mktemp)"
grep -viE '^[[:space:]]*(co-authored-by:|made-with:|made with |generated with |generated-by:)' "$MSG_FILE" > "$TMP" || true
awk '
  { lines[n++] = $0 }
  END {
    while (n > 0 && lines[n - 1] == "") n--
    for (i = 0; i < n; i++) print lines[i]
  }
' "$TMP" > "$MSG_FILE"
rm -f "$TMP"
exit 0
